---
---
import Layout from '../../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const { tag } = Astro.params;
const posts = await getCollection('posts', ({ data }) => !data.draft && data.tags?.includes(tag));

// Sort posts by date (newest first)
const sortedPosts = posts.sort((a, b) => new Date(b.data.date) - new Date(a.data.date));
---

<Layout>
  <h1>Posts tagged: {tag}</h1>

  {sortedPosts.map(post => (
    <div class="post-list-item">
      <span class="post-date">{new Date(post.data.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
      <br />
      <a href={post.slug}>{post.data.title}</a>
    </div>
  ))}
</Layout>