<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Home - HendoCode</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@300;400;500;600&display=swap" rel="stylesheet">
    <style>
      :root {
        /* Light mode */
        --bg: #ffffff;
        --bg-secondary: #f8fafc;
        --text: #1e293b;
        --text-muted: #64748b;
        --accent: #2563eb;
        --accent-hover: #1d4ed8;
        --border: #e2e8f0;
        --code-bg: #f1f5f9;
      }

      @media (prefers-color-scheme: dark) {
        :root {
          /* Dark mode */
          --bg: #0f172a;
          --bg-secondary: #1e293b;
          --text: #e2e8f0;
          --text-muted: #94a3b8;
          --accent: #60a5fa;
          --accent-hover: #93c5fd;
          --border: #334155;
          --code-bg: #1e293b;
        }
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        background-color: var(--bg);
        color: var(--text);
        font-family: 'Inter', sans-serif;
        line-height: 1.7;
        font-size: 16px;
        transition: background-color 0.3s ease, color 0.3s ease;
      }

      .container {
        max-width: 680px;
        margin: 0 auto;
        padding: 0 1rem;
      }

      h1, h2, h3, h4, h5, h6 {
        font-weight: 600;
        line-height: 1.3;
        margin-bottom: 0.5rem;
      }

      h1 {
        font-size: 2rem;
      }

      h2 {
        font-size: 1.5rem;
      }

      h3 {
        font-size: 1.25rem;
      }

      p {
        margin-bottom: 1rem;
      }

      a {
        color: var(--accent);
        text-decoration: none;
      }

      a:hover {
        color: var(--accent-hover);
      }

      code {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.875rem;
        background-color: var(--code-bg);
        padding: 0.2em 0.4em;
        border-radius: 4px;
      }

      pre {
        overflow-x: auto;
        background-color: var(--code-bg);
        padding: 1rem;
        border-radius: 4px;
        margin-bottom: 1rem;
      }

      pre code {
        background: none;
        padding: 0;
      }

      .nav {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1rem 0;
        margin-bottom: 2rem;
        border-bottom: 1px solid var(--border);
      }

      .nav-links {
        display: flex;
        gap: 1.5rem;
        flex-wrap: wrap;
      }

      .nav-link {
        color: var(--text);
        font-weight: 500;
      }

      .nav-link:hover {
        color: var(--accent);
      }

      .theme-toggle {
        background: none;
        border: none;
        cursor: pointer;
        color: var(--text);
        font-size: 1.2rem;
        padding: 0.25rem;
        border-radius: 4px;
      }

      .theme-toggle:hover {
        background-color: var(--bg-secondary);
      }

      .theme-toggle svg {
        display: block;
      }

      .post-date {
        color: var(--text-muted);
        font-size: 0.9rem;
      }

      .tag-chip {
        background-color: var(--bg-secondary);
        color: var(--text-muted);
        padding: 0.25rem 0.5rem;
        border-radius: 9999px;
        font-size: 0.8rem;
        margin-right: 0.5rem;
        margin-bottom: 0.5rem;
        display: inline-block;
      }

      .series-nav {
        margin-top: 2rem;
        padding-top: 1rem;
        border-top: 1px solid var(--border);
      }

      .series-nav a {
        color: var(--text-muted);
      }

      .series-nav a.current {
        color: var(--text);
        font-weight: 600;
      }

      .footer {
        margin-top: 3rem;
        padding: 1rem 0;
        border-top: 1px solid var(--border);
        text-align: center;
        color: var(--text-muted);
        font-size: 0.9rem;
      }

      .post-list-item {
        margin-bottom: 1rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid var(--border);
      }

      .post-list-item:last-child {
        border-bottom: none;
        margin-bottom: 0;
        padding-bottom: 0;
      }

      .project-item {
        margin-bottom: 1.5rem;
      }

      .project-title {
        margin-bottom: 0.25rem;
      }

      .project-description {
        margin-bottom: 0.5rem;
        color: var(--text-muted);
      }

      .project-url {
        color: var(--accent);
      }

      .about-text p {
        margin-bottom: 1rem;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <header class="nav">
        <a href="/" class="nav-link">HendoCode</a>
        <nav class="nav-links">
          <a href="/posts/" class="nav-link">Posts</a>
          <a href="/projects/" class="nav-link">Projects</a>
          <a href="/about/" class="nav-link">About</a>
          <a href="https://github.com/HendoCode" target="_blank" class="nav-link">GitHub</a>
          <button class="theme-toggle" id="themeToggle" aria-label="Toggle theme">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 3v1m0 13v1m9-5h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 1 1-8 0 4 4 0 0 1 8 0z"></path>
            </svg>
          </button>
        </nav>
      </header>

      <main>
        <slot />
      </main>

      <footer class="footer">
        © 2026 Stephen Henderson
      </footer>
    </div>

    <script>
      // Theme toggle functionality
      const themeToggle = document.getElementById('themeToggle');
      const html = document.documentElement;

      // Check for saved theme preference or respect OS preference
      const savedTheme = localStorage.getItem('theme');
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;

      if (savedTheme === 'dark' || (!savedTheme && prefersDark)) {
        html.classList.add('dark');
      }

      themeToggle.addEventListener('click', () => {
        html.classList.toggle('dark');
        const isDark = html.classList.contains('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
      });
    </script>
  </body>
</html>